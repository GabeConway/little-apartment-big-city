node_modules/
dist/
*.local
.DS_Store

# playtest harness screenshots (scripts/playtest.mjs default output)
playtest/

# gemini portrait staging (scripts/gemini-portraits.mjs output; installed art is committed in public/)
art-staging/

# visual-baseline transient output (baselines themselves ARE committed)
tests/visual/current/
tests/visual/diff/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor
.vscode/*
!.vscode/extensions.json
.idea/

# tauri / rust build output (binaries + bundled releases: .app, .dmg, .exe, .msi)
src-tauri/target/
# tauri mobile platform scaffolds (regenerated by `tauri android/ios init`)
src-tauri/gen/

# agent worktrees (transient)
.claude/worktrees/

# gameplay demo recordings (scripts/record-demo.mjs)
demo/
