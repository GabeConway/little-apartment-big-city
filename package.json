{
  "name": "little-apartment-big-city",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "Little Apartment, Big City — standalone cross-platform build (web + Tauri desktop/mobile).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "playtest": "node scripts/playtest.mjs",
    "visual": "node scripts/visual-baseline.mjs",
    "visual:update": "node scripts/visual-baseline.mjs --update",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:mac": "tauri build --target aarch64-apple-darwin && node scripts/make-dmg.mjs",
    "dmg:mac": "node scripts/make-dmg.mjs",
    "ios:dev": "tauri ios dev",
    "ios:build": "tauri ios build",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.5",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  }
}
